{
  "name": "camaro-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "type-check": "npm run type-check --workspaces",
    "check-deps": "tsx ./scripts/check-deps.ts",
    "commitlint": "commitlint --config ./eng/.commitlintrc.json --edit",
    "cspell": "cspell --config ./eng/cspell.config.json --quiet .",
    "eslint": "eslint --config ./eng/eslint.config.js .",
    "lint": "npm run cspell && npm run eslint",
    "lint:staged": "lint-staged --config ./eng/.lintstagedrc.json",
    "prepare": "husky || true",
    "postinstall": "npm run build -w packages/eslint-config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camarojs/camaro.git"
  },
  "author": "Dunn <wg0121@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/camarojs/camaro/issues"
  },
  "homepage": "https://github.com/camarojs/camaro#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "cspell": "^9.3.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsx": "^4.20.6",
    "type-fest": "^5.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "zod": "^4.1.13"
  }
}
