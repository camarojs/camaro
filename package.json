{
  "name": "camaro-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "commitlint": "commitlint --config ./eng/.commitlintrc.json --edit",
    "cspell": "cspell --config ./eng/cspell.config.json --quiet .",
    "eslint": "eslint --config ./eng/eslint.config.ts .",
    "lint": "npm run cspell && npm run eslint",
    "lint:staged": "lint-staged --config ./eng/.lintstagedrc.json",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camarojs/camaro.git"
  },
  "author": "Dunn <wg0121@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/camarojs/camaro/issues"
  },
  "homepage": "https://github.com/camarojs/camaro#readme",
  "devDependencies": {
    "@camaro/tsconfig": "^1.4.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^25.9.5",
    "cspell": "^10.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
