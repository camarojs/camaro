{
  "extends": "@camaro/tsconfig/monorepo.json",
  "compilerOptions": {
    "paths": {
      "@common/*": [
        "../src/common/*"
      ],
      "@core/*": [
        "../src/core/*"
      ],
      "@decorators/*": [
        "../src/decorators/*"
      ],
      "@di/*": [
        "../src/di/*"
      ],
    }
  },
  "references": [
    {
      "path": "../tsconfig.json"
    }
  ]
}
